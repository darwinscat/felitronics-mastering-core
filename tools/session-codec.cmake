# The JSON is the one hand-edited codec description; both outputs are generated here.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/session-codec-schema.json" schema)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/session-abi-v1.txt" frozenCodec REGEX "^(codec|wire|field) ")
# The C header is the one description of the status values: the wire's SessionStatus union is read from it.
if(NOT SESSION_ABI_HEADER)
    set(SESSION_ABI_HEADER "${CMAKE_CURRENT_LIST_DIR}/fc_session_abi.h")
endif()
file(READ "${SESSION_ABI_HEADER}" abiHeader)
string(REGEX REPLACE "//[^\n]*" "" abiHeader "${abiHeader}")
# ...and of the ABI version the generated declaration and runtime constant state.
if(NOT abiHeader MATCHES "\n#define FC_SESSION_ABI_VERSION ([0-9]+)u[ \t\r]*\n")
    message(FATAL_ERROR "${SESSION_ABI_HEADER} declares no FC_SESSION_ABI_VERSION")
endif()
set(abiVersion "${CMAKE_MATCH_1}")
if(NOT abiHeader MATCHES "typedef enum fc_session_status[ \t\r\n]*{([^}]*)}")
    message(FATAL_ERROR "${SESSION_ABI_HEADER} declares no fc_session_status")
endif()
string(REPLACE "," ";" statusEntries "${CMAKE_MATCH_1}")
set(sessionStatus "")
foreach(entry IN LISTS statusEntries)
    string(STRIP "${entry}" entry)
    if(entry STREQUAL "")
        continue()
    endif()
    if(NOT entry MATCHES "^FC_SESSION_[A-Z_]+[ \t]*=[ \t]*([0-9]+)$")
        message(FATAL_ERROR "fc_session_status value without an explicit number: ${entry}")
    endif()
    list(APPEND sessionStatus "${CMAKE_MATCH_1}")
endforeach()
string(JOIN " | " sessionStatus ${sessionStatus})
# A field appended to a frozen record needs a decode default — unless the record mirrors a C struct (Session<Name> for
# fc_session_<name>) whose frozen layout has carried that field since v1: then it is not appended, and a shell must fill it.
function(require_decode_default kind name field noOptional)
    set(frozenRecord FALSE)
    set(frozenField FALSE)
    set(cField "")
    if(kind STREQUAL "wire" AND name MATCHES "^Session([A-Z].*)$")
        string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" cStruct "${CMAKE_MATCH_1}")
        string(TOLOWER "${cStruct}" cStruct)
        set(cField "field fc_session_${cStruct}.${field} ")
    endif()
    foreach(line IN LISTS frozenCodec)
        string(FIND "${line}" "${kind} ${name}." recordAt)
        string(FIND "${line}" "${kind} ${name}.${field} " fieldAt)
        if(recordAt EQUAL 0)
            set(frozenRecord TRUE)
        endif()
        if(fieldAt EQUAL 0)
            set(frozenField TRUE)
        endif()
        if(cField)
            string(FIND "${line}" "${cField}" cFieldAt)
            if(cFieldAt EQUAL 0)
                set(frozenField TRUE)
            endif()
        endif()
    endforeach()
    if(frozenRecord AND NOT frozenField AND noOptional)
        message(FATAL_ERROR "Appended v1 field ${name}.${field} needs an optional decode default")
    endif()
endfunction()
set(cpp "// SPDX-License-Identifier: AGPL-3.0-or-later\n// Copyright (c) 2026 Darwin's Cat — Oleh Tsymaienko & Alisa Lafoks. Part of felitronics-mastering-core — see LICENSE.\n// Generated by tools/session-codec.cmake from tools/session-codec-schema.json.\n\n#pragma once\n\n#include <felitronics/session/Snapshot.h>\n#include <type_traits>\n\nnamespace felitronics::session::detail\n{\n")
set(ts "// Generated by tools/session-codec.cmake. Do not edit.\nexport type WireNumber = number | \"-Infinity\" | \"Infinity\" | \"NaN\";\n")
string(APPEND cpp "template <class T> constexpr unsigned enumLast() noexcept\n{\n")
string(JSON count LENGTH "${schema}" enums)
math(EXPR last "${count} - 1")
set(prefix "")
set(enum_checks "")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" enums ${i})
    string(JSON n LENGTH "${schema}" enums ${name})
    math(EXPR end "${n} - 1")
    string(APPEND cpp "    ${prefix}if constexpr (std::is_same_v<T, ${name}>)\n    {\n")
    set(prefix "else ")
    string(APPEND enum_checks "constexpr void checkEnum (${name} value) noexcept\n{\n    switch (value)\n    {\n")
    string(APPEND ts "export type ${name} = ")
    foreach(j RANGE ${end})
        string(JSON value GET "${schema}" enums ${name} ${j})
        if(j GREATER 0)
            string(APPEND ts " | ")
        endif()
        string(APPEND ts "${j} /* ${value} */")
        string(APPEND cpp "        static_assert (unsigned (${name}::${value}) == ${j});\n")
        string(APPEND enum_checks "        case ${name}::${value}: break;\n")
    endforeach()
    string(APPEND ts ";\n")
    string(APPEND cpp "        return ${end};\n    }\n")
    string(APPEND enum_checks "    }\n}\n\n")
endforeach()
string(APPEND cpp "    else static_assert (std::is_same_v<T, void>, \"enum missing from codec description\");\n}\n\n${enum_checks}template <class V, class T> void describe (V& v, T& x) noexcept\n{\n    using U = std::remove_cv_t<T>;\n")
function(wire_type type out)
    if(type MATCHES "^(.*)\\?$" )
        wire_type("${CMAKE_MATCH_1}" inner)
        set(value "${inner} | null")
    elseif(type MATCHES "^(.*)\\[\\]$")
        wire_type("${CMAKE_MATCH_1}" inner)
        set(value "ReadonlyArray<${inner}>")
    elseif(type STREQUAL "double")
        set(value WireNumber)
    elseif(type STREQUAL "uint64" OR type STREQUAL "string")
        set(value string)
    elseif(type MATCHES "^(uint32|uint16|uint8|int32|bytes)$")
        set(value number)
    elseif(type STREQUAL "bool")
        set(value boolean)
    else()
        set(value "${type}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(cpp_type type out)
    if(type MATCHES "^(.*)\\?$" )
        cpp_type("${CMAKE_MATCH_1}" inner)
        set(value "std::optional<${inner}>")
    elseif(type MATCHES "^(.*)\\[\\]$")
        cpp_type("${CMAKE_MATCH_1}" inner)
        set(value "std::span<const ${inner}>")
    elseif(type STREQUAL "double" OR type STREQUAL "bytes")
        set(value double)
    elseif(type MATCHES "^(uint64|uint32|uint16|uint8|int32)$")
        set(value "std::${type}_t")
    elseif(type STREQUAL "string")
        set(value "std::string_view")
    elseif(type STREQUAL "bool")
        set(value bool)
    else()
        string(JSON value ERROR_VARIABLE error GET "${schema}" records ${type} cpp)
        if(error)
            set(value "${type}")
        endif()
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
string(JSON count LENGTH "${schema}" records)
math(EXPR last "${count} - 1")
set(prefix "")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" records ${i})
    string(JSON type GET "${schema}" records ${name} cpp)
    string(APPEND cpp "    ${prefix}if constexpr (std::is_same_v<U, ${type}>)\n    {\n")
    set(prefix "else ")
    string(APPEND ts "export interface ${name} {\n")
    string(JSON n LENGTH "${schema}" records ${name} fields)
    math(EXPR end "${n} - 1")
    set(bindings "")
    foreach(j RANGE ${end})
        if(j GREATER 0)
            string(APPEND bindings ", ")
        endif()
        string(APPEND bindings "f${j}")
    endforeach()
    string(APPEND cpp "        [[maybe_unused]] auto& [${bindings}] = x;\n")
    foreach(j RANGE ${end})
        string(JSON field MEMBER "${schema}" records ${name} fields ${j})
        string(JSON type GET "${schema}" records ${name} fields ${field})
        wire_type("${type}" mapped)
        cpp_type("${type}" declared)
        string(APPEND cpp "        static_assert (std::is_same_v<std::remove_cvref_t<decltype (x.${field})>, ${declared}>);\n")
        set(visitor field)
        set(optionalArgument "")
        set(optionalSuffix "")
        string(JSON optional ERROR_VARIABLE noOptional GET "${schema}" optionalFields ${name} ${field})
        require_decode_default(codec "${name}" "${field}" "${noOptional}")
        if(NOT noOptional)
            string(JSON default GET "${optional}" default)
            string(JSON description GET "${optional}" description)
            set(visitor optionalField)
            set(optionalArgument ", ${default}")
            set(optionalSuffix "?")
            string(APPEND ts "  /** Decode default: ${description} */\n")
        endif()
        string(APPEND cpp "        v.${visitor} (\"${field}\", x.${field}${optionalArgument});\n")
        string(APPEND ts "  readonly ${field}${optionalSuffix}: ${mapped};\n")
    endforeach()
    string(APPEND cpp "    }\n")
    string(APPEND ts "}\n")
endforeach()
string(JSON viewCount LENGTH "${schema}" transportRecordViews)
math(EXPR lastView "${viewCount} - 1")
foreach(i RANGE ${lastView})
    string(JSON name MEMBER "${schema}" transportRecordViews ${i})
    string(JSON source GET "${schema}" transportRecordViews ${name} from)
    string(APPEND ts "export interface ${name} {\n")
    string(JSON n LENGTH "${schema}" records ${source} fields)
    math(EXPR end "${n} - 1")
    foreach(j RANGE ${end})
        string(JSON field MEMBER "${schema}" records ${source} fields ${j})
        string(JSON type GET "${schema}" records ${source} fields ${field})
        wire_type("${type}" mapped)
        string(JSON override ERROR_VARIABLE noOverride GET "${schema}" transportRecordViews ${name} fields ${field})
        if(NOT noOverride)
            set(mapped "${override}")
        endif()
        set(optionalSuffix "")
        string(JSON optional ERROR_VARIABLE noOptional GET "${schema}" optionalFields ${source} ${field})
        if(NOT noOptional)
            set(optionalSuffix "?")
        endif()
        string(APPEND ts "  readonly ${field}${optionalSuffix}: ${mapped};\n")
    endforeach()
    string(APPEND ts "}\n")
endforeach()
string(APPEND cpp "    else static_assert (std::is_same_v<U, void>, \"type missing from codec description\");\n}\n} // namespace felitronics::session::detail\n")
set(header "${root}/modules/session/src/CodecSchema.h")
if(UPDATE)
    file(WRITE "${header}" "${cpp}")
else()
    file(READ "${header}" actual)
    if(NOT actual STREQUAL cpp)
        message(FATAL_ERROR "CodecSchema.h differs from its description; run cmake -DUPDATE=ON -P tools/session-codec.cmake")
    endif()
endif()
string(JSON queryCount LENGTH "${schema}" queryRows)
math(EXPR queryLast "${queryCount} - 1")
foreach(i RANGE ${queryLast})
    string(JSON name MEMBER "${schema}" queryRows ${i})
    string(JSON n LENGTH "${schema}" queryRows ${name})
    math(EXPR end "${n} - 1")
    string(APPEND ts "export type Query${name}Row = readonly [")
    foreach(j RANGE ${end})
        string(JSON field GET "${schema}" queryRows ${name} ${j})
        if(j GREATER 0)
            string(APPEND ts ", ")
        endif()
        string(APPEND ts "${field}: number")
    endforeach()
    string(APPEND ts "];\n")
endforeach()
# Transport declarations share the schema with the recorded JSON codec. Rows replace only
# the binaryRows listed in the schema; every other field keeps its generated type.
string(APPEND ts "// A thrown wasm trap/abort is status 14; discard the instance. Later calls are status 1 (poisoned), publish nothing; recover by replay in a fresh instance.\n")
string(APPEND ts "export declare const FC_SESSION_ABI_VERSION: ${abiVersion};\nexport declare function invokeSession(entry: (...args: number[]) => number, ...args: number[]): SessionStatus;\n")
if(VERSION_FILE)
    file(READ "${VERSION_FILE}" version)
    string(STRIP "${version}" version)
    if(NOT version MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "config version must be hexadecimal")
    endif()
    string(APPEND ts "export declare const FC_SESSION_CONFIG_VERSION: \"${version}\";\n")
endif()
string(JSON count LENGTH "${schema}" transportEnums)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" transportEnums ${i})
    string(JSON n LENGTH "${schema}" transportEnums ${name})
    math(EXPR end "${n} - 1")
    string(APPEND ts "export type ${name} = ")
    foreach(j RANGE ${end})
        string(JSON value GET "${schema}" transportEnums ${name} ${j})
        if(j GREATER 0)
            string(APPEND ts " | ")
        endif()
        string(APPEND ts "${j} /* ${value} */")
    endforeach()
    string(APPEND ts ";\n")
endforeach()
string(JSON statusListed ERROR_VARIABLE statusAbsent GET "${schema}" wireAliases SessionStatus)
if(NOT statusAbsent)
    message(FATAL_ERROR "SessionStatus is generated from fc_session_status; the schema must not list it")
endif()
# In its place among the aliases, which the JSON walk yields in name order.
set(statusWritten FALSE)
string(JSON count LENGTH "${schema}" wireAliases)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" wireAliases ${i})
    string(JSON value GET "${schema}" wireAliases ${name})
    if(NOT statusWritten AND "SessionStatus" STRLESS "${name}")
        string(APPEND ts "export type SessionStatus = ${sessionStatus};\n")
        set(statusWritten TRUE)
    endif()
    string(APPEND ts "export type ${name} = ${value};\n")
endforeach()
if(NOT statusWritten)
    string(APPEND ts "export type SessionStatus = ${sessionStatus};\n")
endif()
string(JSON count LENGTH "${schema}" wireRecords)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" wireRecords ${i})
    string(APPEND ts "export interface ${name} {\n")
    string(JSON n LENGTH "${schema}" wireRecords ${name})
    math(EXPR end "${n} - 1")
    foreach(j RANGE ${end})
        string(JSON field MEMBER "${schema}" wireRecords ${name} ${j})
        string(JSON type GET "${schema}" wireRecords ${name} ${field})
        set(optionalSuffix "")
        string(JSON optional ERROR_VARIABLE noOptional GET "${schema}" optionalWireFields ${name} ${field})
        require_decode_default(wire "${name}" "${field}" "${noOptional}")
        if(NOT noOptional)
            string(JSON default GET "${optional}" defaultJson)
            string(JSON description GET "${optional}" description)
            set(optionalSuffix "?")
            string(APPEND ts "  /** Decode default: ${default}. ${description} */\n")
        endif()
        string(APPEND ts "  readonly ${field}${optionalSuffix}: ${type};\n")
    endforeach()
    string(APPEND ts "}\n")
endforeach()
string(APPEND ts "// Row buffers are LITTLE-ENDIAN IEEE-754 f64; decode with Float64Array. Big-endian builds are refused.\n")
string(APPEND ts "export interface SessionSnapshot {\n")
string(JSON n LENGTH "${schema}" records Snapshot fields)
math(EXPR end "${n} - 1")
foreach(j RANGE ${end})
    string(JSON field MEMBER "${schema}" records Snapshot fields ${j})
    string(JSON type GET "${schema}" records Snapshot fields ${field})
    wire_type("${type}" mapped)
    string(JSON rowCount LENGTH "${schema}" binaryRows)
    math(EXPR lastRow "${rowCount} - 1")
    foreach(row RANGE ${lastRow})
        string(JSON binaryField GET "${schema}" binaryRows ${row})
        if(field STREQUAL binaryField)
            set(mapped Row)
        endif()
    endforeach()
    string(JSON override ERROR_VARIABLE noOverride GET "${schema}" wireTypeOverrides ${field})
    if(NOT noOverride)
        set(mapped "${override}")
    endif()
    set(optionalSuffix "")
    string(JSON description ERROR_VARIABLE noOptional GET "${schema}" optionalFields Snapshot ${field} description)
    if(NOT noOptional)
        set(optionalSuffix "?")
        string(APPEND ts "  /** Decode default: ${description} */\n")
    endif()
    string(APPEND ts "  readonly ${field}${optionalSuffix}: ${mapped};\n")
endforeach()
string(APPEND ts "}\n")
if(OUTPUT)
    if(VERSION_FILE)
        string(REGEX REPLACE "\\.d\\.ts$" ".mjs" runtime "${OUTPUT}")
        file(READ "${CMAKE_CURRENT_LIST_DIR}/session-runtime.mjs.in" runtimeSource)
        string(REPLACE "@CONFIG_VERSION@" "${version}" runtimeSource "${runtimeSource}")
        string(REPLACE "@ABI_VERSION@" "${abiVersion}" runtimeSource "${runtimeSource}")
    endif()
    if(CHECK)
        file(READ "${OUTPUT}" actual)
        if(NOT actual STREQUAL ts)
            message(FATAL_ERROR "snapshot.d.ts differs from the codec description")
        endif()
        if(VERSION_FILE)
            file(READ "${runtime}" actualRuntime)
            if(NOT actualRuntime STREQUAL runtimeSource)
                message(FATAL_ERROR "snapshot.mjs differs from the codec description")
            endif()
        endif()
    else()
        file(WRITE "${OUTPUT}" "${ts}")
        if(VERSION_FILE)
            file(WRITE "${runtime}" "${runtimeSource}")
        endif()
    endif()
endif()
