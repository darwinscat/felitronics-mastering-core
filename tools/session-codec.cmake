# The JSON is the one hand-edited codec description; both outputs are generated here.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${CMAKE_CURRENT_LIST_DIR}/session-codec-schema.json" schema)
set(cpp "// SPDX-License-Identifier: AGPL-3.0-or-later\n// Copyright (c) 2026 Darwin's Cat — Oleh Tsymaienko & Alisa Lafoks. Part of felitronics-mastering-core — see LICENSE.\n// Generated by tools/session-codec.cmake from tools/session-codec-schema.json.\n\n#pragma once\n\n#include <felitronics/session/Snapshot.h>\n#include <type_traits>\n\nnamespace felitronics::session::detail\n{\n")
set(ts "// Generated by tools/session-codec.cmake. Do not edit.\nexport type WireNumber = number | \"-Infinity\" | \"Infinity\" | \"NaN\";\n")
string(APPEND cpp "template <class T> constexpr unsigned enumLast() noexcept\n{\n")
string(JSON count LENGTH "${schema}" enums)
math(EXPR last "${count} - 1")
set(prefix "")
set(enum_checks "")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" enums ${i})
    string(JSON n LENGTH "${schema}" enums ${name})
    math(EXPR end "${n} - 1")
    string(APPEND cpp "    ${prefix}if constexpr (std::is_same_v<T, ${name}>)\n    {\n")
    set(prefix "else ")
    string(APPEND enum_checks "constexpr void checkEnum (${name} value) noexcept\n{\n    switch (value)\n    {\n")
    string(APPEND ts "export type ${name} = ")
    foreach(j RANGE ${end})
        string(JSON value GET "${schema}" enums ${name} ${j})
        if(j GREATER 0)
            string(APPEND ts " | ")
        endif()
        string(APPEND ts "${j} /* ${value} */")
        string(APPEND cpp "        static_assert (unsigned (${name}::${value}) == ${j});\n")
        string(APPEND enum_checks "        case ${name}::${value}: break;\n")
    endforeach()
    string(APPEND ts ";\n")
    string(APPEND cpp "        return ${end};\n    }\n")
    string(APPEND enum_checks "    }\n}\n\n")
endforeach()
string(APPEND cpp "    else static_assert (std::is_same_v<T, void>, \"enum missing from codec description\");\n}\n\n${enum_checks}template <class V, class T> void describe (V& v, T& x) noexcept\n{\n    using U = std::remove_cv_t<T>;\n")
function(wire_type type out)
    if(type MATCHES "^(.*)\\?$" )
        wire_type("${CMAKE_MATCH_1}" inner)
        set(value "${inner} | null")
    elseif(type MATCHES "^(.*)\\[\\]$")
        wire_type("${CMAKE_MATCH_1}" inner)
        set(value "ReadonlyArray<${inner}>")
    elseif(type STREQUAL "double")
        set(value WireNumber)
    elseif(type STREQUAL "uint64" OR type STREQUAL "string")
        set(value string)
    elseif(type MATCHES "^(uint32|uint16|uint8|int32|bytes)$")
        set(value number)
    elseif(type STREQUAL "bool")
        set(value boolean)
    else()
        set(value "${type}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(cpp_type type out)
    if(type MATCHES "^(.*)\\?$" )
        cpp_type("${CMAKE_MATCH_1}" inner)
        set(value "std::optional<${inner}>")
    elseif(type MATCHES "^(.*)\\[\\]$")
        cpp_type("${CMAKE_MATCH_1}" inner)
        set(value "std::span<const ${inner}>")
    elseif(type STREQUAL "double" OR type STREQUAL "bytes")
        set(value double)
    elseif(type MATCHES "^(uint64|uint32|uint16|uint8|int32)$")
        set(value "std::${type}_t")
    elseif(type STREQUAL "string")
        set(value "std::string_view")
    elseif(type STREQUAL "bool")
        set(value bool)
    else()
        string(JSON value ERROR_VARIABLE error GET "${schema}" records ${type} cpp)
        if(error)
            set(value "${type}")
        endif()
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
string(JSON count LENGTH "${schema}" records)
math(EXPR last "${count} - 1")
set(prefix "")
foreach(i RANGE ${last})
    string(JSON name MEMBER "${schema}" records ${i})
    string(JSON type GET "${schema}" records ${name} cpp)
    string(APPEND cpp "    ${prefix}if constexpr (std::is_same_v<U, ${type}>)\n    {\n")
    set(prefix "else ")
    string(APPEND ts "export interface ${name} {\n")
    string(JSON n LENGTH "${schema}" records ${name} fields)
    math(EXPR end "${n} - 1")
    set(bindings "")
    foreach(j RANGE ${end})
        if(j GREATER 0)
            string(APPEND bindings ", ")
        endif()
        string(APPEND bindings "f${j}")
    endforeach()
    string(APPEND cpp "        [[maybe_unused]] auto& [${bindings}] = x;\n")
    foreach(j RANGE ${end})
        string(JSON field MEMBER "${schema}" records ${name} fields ${j})
        string(JSON type GET "${schema}" records ${name} fields ${field})
        wire_type("${type}" mapped)
        cpp_type("${type}" declared)
        string(APPEND cpp "        static_assert (std::is_same_v<std::remove_cvref_t<decltype (x.${field})>, ${declared}>);\n")
        string(APPEND cpp "        v.field (\"${field}\", x.${field});\n")
        string(APPEND ts "  readonly ${field}: ${mapped};\n")
    endforeach()
    string(APPEND cpp "    }\n")
    string(APPEND ts "}\n")
endforeach()
string(APPEND cpp "    else static_assert (std::is_same_v<U, void>, \"type missing from codec description\");\n}\n} // namespace felitronics::session::detail\n")
set(header "${root}/modules/session/src/CodecSchema.h")
if(UPDATE)
    file(WRITE "${header}" "${cpp}")
else()
    file(READ "${header}" actual)
    if(NOT actual STREQUAL cpp)
        message(FATAL_ERROR "CodecSchema.h differs from its description; run cmake -DUPDATE=ON -P tools/session-codec.cmake")
    endif()
endif()
if(OUTPUT)
    if(CHECK)
        file(READ "${OUTPUT}" actual)
        if(NOT actual STREQUAL ts)
            message(FATAL_ERROR "snapshot.d.ts differs from the codec description")
        endif()
    else()
        file(WRITE "${OUTPUT}" "${ts}")
    endif()
endif()
